# ─────────────────────────────────────────────────────────────
#  Alcodraft — environment variables
#  Copy to .env.local (never commit real values).
# ─────────────────────────────────────────────────────────────

# Supabase Postgres — Dashboard → your project → "Connect" → Connection string.
# Replace [YOUR-PASSWORD] with the database password
# (Project Settings → Database → Reset database password, if you don't know it).

# 1) Transaction pooler (port 6543) — used by the app at runtime (next dev, Vercel).
DATABASE_URL="postgresql://postgres.cjalkkgttjoqqjkdlzzq:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres"

# 2) Session pooler (port 5432) — used by scripts: schema migrations and the legacy data import.
DATABASE_URL_SESSION="postgresql://postgres.cjalkkgttjoqqjkdlzzq:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# Legacy MySQL (local import of alcodraf_base.sql) — read only by the migration script.
LEGACY_DATABASE_URL="mysql://root@127.0.0.1:3306/alcodraft_legacy"
